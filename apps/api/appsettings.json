{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Supabase": {
    "Storage": {
      "ProfileImagesBucket": "avatars",
      "VehicleImagesBucket": "vehicles"
    }
  },
  "AgentAi": {
    "Enabled": true,
    "Provider": "Gemini",
    "Model": "gemini-3.5-flash-lite",
    "PromptVersion": "recovery-planner-v1",
    "TimeoutSeconds": 20,
    "MaxPlanningRetries": 1,
    "MaxWorkflowReplans": 1,
    "MaximumPlanSteps": 8
  },
  "AllowedHosts": "*"
}
